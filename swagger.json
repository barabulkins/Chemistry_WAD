        "summary": "Публикация черновика текущего создателя",
        "tags": [
          "ApiSamples",
          "Методы создателя (Защищенные — с авторизацией)"
        ]
      }
    },
    "/api/samples/{id}/like": {
      "post": {
        "description": "Ставит (value=1) или снимает (value=0) отметку \"нравится\" от имени текущего авторизованного пользователя. Требует авторизации.",
        "operationId": "ApiSamplesController_like",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID образца",
            "schema": {
              "example": 1,
