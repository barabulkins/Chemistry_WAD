    "/api/samples": {
      "get": {
        "description": "Получение всех услуг (химических образцов) аналитической лаборатории. Доступно всем посетителям без авторизации. Если пользователь авторизован, признаки is_creator и is_liked вычисляются для него; для гостя возвращаются нули (0).",
        "operationId": "ApiSamplesController_getAll",
        "parameters": [
          {
            "name": "gas_volume",
            "required": false,
            "in": "query",
            "description": "Фильтрация по объёму выделившегося газа (мл)",
            "schema": {
              "example": 45,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список опубликованных образцов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SampleResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "GET получение всех услуг (каталог опубликованных образцов)",
        "tags": [
          "ApiSamples",
          "Публичные методы (Чтение — без авторизации)"
        ]
      },
      "post": {
        "description": "Инициализирует новый черновик химического образца. creator_id АВТОМАТИЧЕСКИ заполняется из сессии текущего пользователя! Файлы изображения и видео загружаются в S3 хранилище MinIO. Требует авторизации.",
        "operationId": "ApiSamplesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateSampleDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Черновик успешно создан с автозаполнением автора",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Не заполнены обязательные файлы или уже есть активный черновик"
          },
          "401": {
            "description": "Не авторизован (гость не имеет права создавать)"
          }
        },
        "security": [
          {
            "connect.sid": []
          }
        ],
        "summary": "Создание нового черновика услуги с автозаполнением создателя",
        "tags": [
          "ApiSamples",
          "Методы создателя (Защищенные — с авторизацией)"
        ]
      }
    },
    "/api/samples/feed": {
      "get": {
        "description": "Режим постраничного просмотра карточек ленты с закольцовыванием. Без параметров возвращает первый образец. С параметрами ?id=X&next=true возвращает следующий. Доступно без авторизации.",
        "operationId": "ApiSamplesController_getFeed[0]",
        "parameters": [
          {
            "name": "id",
            "required": false,
            "in": "query",
            "description": "ID текущего образца для отсчета",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "next",
            "required": false,
            "in": "query",
            "description": "Флаг \"true\" для перехода к следующей карточке ленты",
            "schema": {
              "example": "true",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные карточки образца",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleResponseDto"
                }
              }
            }
          }
        },
        "summary": "Лента опубликованных образцов (по одной карточке)",
        "tags": [
          "ApiSamples",
          "Публичные методы (Чтение — без авторизации)"
        ]
      }
    },
    "/api/samples/feed/{id}": {
      "get": {
        "description": "Режим постраничного просмотра карточек ленты с закольцовыванием. Без параметров возвращает первый образец. С параметрами ?id=X&next=true возвращает следующий. Доступно без авторизации.",
        "operationId": "ApiSamplesController_getFeed[1]",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "next",
            "required": false,
