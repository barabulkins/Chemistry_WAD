    "/api/samples/{id}": {
      "get": {
        "description": "Возвращает подробные характеристики конкретного опубликованного химического образца. Доступно без авторизации.",
        "operationId": "ApiSamplesController_getOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Уникальный идентификатор образца",
            "schema": {
              "example": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные образца",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SampleResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Образец не найден или не опубликован"
          }
        },
        "summary": "Детальный просмотр опубликованного образца по ID",
        "tags": [
          "ApiSamples",
          "Публичные методы (Чтение — без авторизации)"
        ]
      },
      "delete": {
        "description": "Логически удаляет образец (status = deleted) с использованием SQL-курсора FOR UPDATE в транзакции. Удалить разрешено ТОЛЬКО собственный образец создателя (creator_id == session.userId). Требует авторизации.",
        "operationId": "ApiSamplesController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID удаляемого химического образца",
            "schema": {
              "example": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Образец успешно удален",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteSampleResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          },
          "404": {
            "description": "Образец не найден или принадлежит другому автору"
          }
        },
        "security": [
          {
            "connect.sid": []
          }
        ],
        "summary": "Логическое удаление образца (Soft Delete через курсор SQL)",
        "tags": [
          "ApiSamples",
          "Методы создателя (Защищенные — с авторизацией)"
        ]
      }
    },
    "/api/samples/publish": {
      "put": {
        "description": "Переводит черновик текущего авторизованного пользователя из статуса \"draft\" в \"published\", фиксирует дату публикации formation_date = NOW() и параметры образца. Требует авторизации.",
        "operationId": "ApiSamplesController_publish",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
