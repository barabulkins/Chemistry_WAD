  "info": {
    "title": "Управление химическими образцами — Веб-сервис (ЛР4)",
    "description": "",
    "version": "4.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SampleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Идентификатор образца",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Название образца",
            "example": "Известняк"
          },
          "description": {
            "type": "string",
            "description": "Описание образца",
            "example": "Технический образец..."
          },
          "status": {
            "type": "string",
            "description": "Статус образца",
            "example": "published",
            "enum": [
              "draft",
              "published",
              "deleted"
            ]
          },
          "image_url": {
            "type": "string",
            "description": "Ссылка на изображение в MinIO S3",
            "example": "http://127.0.0.1:9000/chemistry1/img_123.jpg"
          },
          "video_url": {
            "type": "string",
            "description": "Ссылка на видео в MinIO S3",
            "example": "http://127.0.0.1:9000/chemistry1/vid_123.mp4"
          },
          "impurities_percent": {
            "type": "number",
            "description": "Массовая доля примесей (%)",
            "example": 15.5
          },
          "gas_volume": {
            "type": "number",
            "description": "Объем выделившегося газа (мл)",
            "example": 45
          },
          "created_at": {
            "format": "date-time",
            "type": "string",
            "description": "Дата создания записи",
            "example": "2026-10-21T00:00:00.000Z"
          },
          "formation_date": {
            "format": "date-time",
            "type": "string",
            "description": "Дата публикации образца",
            "example": "2026-10-21T01:00:00.000Z"
          },
          "likes": {
            "type": "number",
            "description": "Общее количество лайков",
            "example": 5
          },
          "is_creator": {
            "type": "number",
            "description": "Признак (0/1): является ли текущий пользователь автором образца (0 для гостя)",
            "example": 1
          },
          "is_liked": {
            "type": "number",
            "description": "Признак (0/1): поставил ли текущий пользователь лайк данному образцу (0 для гостя)",
            "example": 0
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "image_url",
          "video_url",
          "created_at",
          "likes",
          "is_creator",
          "is_liked"
        ]
      },
      "CreateSampleDto": {
        "type": "object",
