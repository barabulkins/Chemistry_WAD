        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleLikeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результат операции лайка",
