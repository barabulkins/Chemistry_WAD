              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToggleLikeResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректное значение value (должно быть 0 или 1)"
          },
          "401": {
            "description": "Не авторизован"
          },
          "404": {
            "description": "Образец не найден"
          }
        },
        "security": [
          {
            "connect.sid": []
          }
        ],
        "summary": "Поставить / отменить лайк образцу",
        "tags": [
          "ApiSamples",
          "Методы создателя (Защищенные — с авторизацией)"
        ]
      }
    },
    "/api/users/register": {
      "post": {
        "description": "Создает нового пользователя с защищенным хэшированием пароля (bcrypt) и автоматически выполняет вход, создавая серверную сессию и устанавливая сессионную куку connect.sid.",
        "operationId": "ApiUsersController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь успешно зарегистрирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "400": {
