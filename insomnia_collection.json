        {
          "name": "POST добавление",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Новый экспериментальный образец",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "description": "Файл изображения (обязательно)"
                },
                {
                  "key": "video",
                  "type": "file",
                  "description": "Файл короткого видео (обязательно)"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:3000/api/samples",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "samples"]
            },
            "description": "POST добавление + добавление файлов изображения и короткого видео (как файлы а НЕ просто URL), название файлов сохраняются в полях БД, а сами файлы в minio. Названия файлов генерируются на латинице"
          }
        },
        {
