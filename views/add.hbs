<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление (Черновик)</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    <div class="content-area add-page">
      <h1 class="add-header">Новый образец</h1>
      
      {{#if sample}}
      <form>
        <div class="form-section">
          <h3>Медиа</h3>
          <div class="form-group">
            <label>Изображение (файл)</label>
            <div style="width: 100%; height: 150px; background: #eee; border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; color: #999; border-radius: 10px; font-size: 14px;">
              Превью изображения
            </div>
            <input type="file" class="form-control" name="image" accept="image/*">
          </div>
          <div class="form-group">
            <label>Видео (файл)</label>
            <div style="width: 100%; height: 150px; background: #eee; border: 2px dashed #ccc; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; color: #999; border-radius: 10px; font-size: 14px;">
              Превью видео
            </div>
            <input type="file" class="form-control" name="video" accept="video/*">
          </div>
        </div>

        <div class="form-section">
          <h3>Описание и Параметры</h3>
          <div class="form-group">
            <label>Название</label>
            <input type="text" class="form-control" name="title" value="{{sample.title}}">
          </div>
          <div class="form-group">
            <label>Описание</label>
            <textarea class="form-control" name="description" rows="3">{{sample.description}}</textarea>
          </div>
          
          <div class="form-group">
            <label>Массовая доля примесей (%, в 1 кг образца)</label>
            <input type="number" step="0.1" class="form-control" name="impurities_percent" value="{{sample.impurities_percent}}">
          </div>
          <div class="form-group">
            <label>Выделившийся газ (мл из 1 кг)</label>
            <input type="number" class="form-control" name="gas_volume" value="{{sample.gas_volume}}">
          </div>
        </div>
      </form>
      {{else}}
        <p>Черновик не найден</p>
      {{/if}}
    </div>
    
    {{> nav}}
  </div>
</body>
</html>