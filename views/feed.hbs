<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Лента</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-container">
    <div class="content-area feed-container">
      {{#if sample}}
        <video class="feed-video" autoplay loop muted playsinline
          poster="{{#if sample.image_url}}{{sample.image_url}}{{else}}/default.jpg{{/if}}"
          onerror="this.poster='/default.jpg'; this.src='/default.mp4';">
          <source src="{{#if sample.video_url}}{{sample.video_url}}{{else}}/default.mp4{{/if}}" type="video/mp4">
        </video>
        
        <!-- Нижняя инфо-панель (поверх видео) -->
        <div class="feed-overlay">
          <!-- Описание -->
          <div class="feed-desc-row" style="display: flex; align-items: flex-end;">
            <span class="feed-desc-text" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{{sample.title}} 🔥 {{sample.description}}</span>
            <span class="feed-desc-more" style="white-space: nowrap; margin-left: 5px;">Еще</span>
          </div>
        </div>

        <!-- Правый столбец кнопок и параметров -->
        <div class="feed-actions">
          <!-- Параметры по теме -->
          <div class="action-btn" title="Примеси (%, в 1 кг образца)">
            <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
            <span class="count">{{sample.impurities_percent}}%</span>
          </div>
          <div class="action-btn" title="Объем газа (мл из 1 кг)">
            <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            <span class="count">{{sample.gas_volume}} мл</span>
          </div>

          <!-- Иконка лайка (только отображение из БД) -->
          <div class="action-btn">
            <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span class="count">{{sample.likes}}</span>
          </div>
          
          <!-- Кнопка следующий образец -->
          <a href="/technical-samples/feed/{{sample.id}}?next=true" class="next-btn" title="Следующий образец">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
        </div>
      {{else}}
        <div style="padding: 20px; color: white;">Нет доступных образцов</div>
      {{/if}}
    </div>
    
    {{> nav}}
  </div>
</body>
</html>